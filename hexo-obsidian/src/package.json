{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "hexo generate",
    "clean": "hexo clean && npm run cosma-rm-output",
    "deploy": "hexo deploy",
    "server": "hexo server",
    "github": "npm run clean && hexo generate && npm run gen-cosma ",
    "local": "hexo clean && npm run cosma-rm-output && hexo generate && npm run gen-cosma && hexo server",
    "prepublish": "npm run check-markdown-filename",
    "publish": "hexo clean && hexo g && npm run gen-cosma && hexo d",
    "postpublish": "hexo algolia && npm run flush-cdn",
    "prestart": "npm run check-markdown-filename",
    "flush-cdn": "node my_scripts/auto_flush_cdn.js",
    "check-markdown-filename": "python3 my_scripts/check_md_name.py source/_posts",
    "ob2co": "python3 my_scripts/obsidian2cosma.py -i source/_posts -o my_scripts/cosma_dir/data --ignore -f --method abbrlink --attrreplacement categories,types date,begin --verbose",
    "cosma-total": "cd my_scripts/cosma_dir/dir_total && cosma m",
    "cosma-trim": "cd my_scripts/cosma_dir/dir_trim && cosma m && python3 ../../cosmoscope_trim.py ../../cosma_dir/dir_trim/cosmoscope.html",
    "cosma-copy": "mkdir -p public/DO_NOT_render/cosmoscope && cp my_scripts/cosma_dir/dir_trim/cosmoscope_trim.html public/DO_NOT_render/cosmoscope && cp my_scripts/cosma_dir/dir_total/cosmoscope.html public/DO_NOT_render/cosmoscope",
    "cosma-rm-output": "rm -rf  my_scripts/cosma_dir/data",
    "gen-cosma": "npm run ob2co && npm run cosma-total && npm run cosma-trim && npm run cosma-copy && npm run cosma-rm-output"
  },
  "hexo": {
    "version": "7.3.0"
  },
  "dependencies": {
    "@graphlab-fr/cosma": "^2.5.4",
    "hexo": "^7.0.0",
    "hexo-abbrlink": "^2.2.1",
    "hexo-blog-encrypt": "^3.1.9",
    "hexo-deployer-git": "^4.0.0",
    "hexo-filter-flowchart": "^1.0.4",
    "hexo-filter-mathjax": "^0.9.0",
    "hexo-filter-mermaid-diagrams": "^1.0.5",
    "hexo-filter-plantuml": "^2.1.1",
    "hexo-filter-sequence": "^1.0.3",
    "hexo-filter-titlebased-link": "^0.2.6",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-feed": "^3.0.0",
    "hexo-generator-index": "^3.0.0",
    "hexo-generator-searchdb": "^1.4.1",
    "hexo-generator-tag": "^2.0.0",
    "hexo-helper-live2d": "^3.1.1",
    "hexo-related-popular-posts": "^5.0.1",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-kramed": "^0.1.4",
    "hexo-renderer-markdown-it-plus": "^1.0.6",
    "hexo-renderer-pug": "^3.0.0",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "hexo-tag-aplayer": "^3.0.4",
    "hexo-theme-butterfly": "^5.3.5",
    "hexo-wordcount": "^6.0.1",
    "live2d-widget-model-hijiki": "^1.0.5",
    "live2d-widget-model-miku": "^1.0.5",
    "live2d-widget-model-tororo": "^1.0.5",
    "markdown-it-obsidian-imgsize": "^0.1.1",
    "markdown-it-task-lists": "^2.1.1",
    "mdit-plugin-callouts": "^1.2.0"
  }
}
